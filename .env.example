# AI engines for GEO tracking. Any engine without a key is skipped.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Optional: Google PageSpeed Insights (Core Web Vitals). Works without a key at low volume.
PAGESPEED_API_KEY=

# Required in production: random salt for hashing visitor IPs (openssl rand -hex 32).
REQUESTER_SALT=

# Transactional email for signup verification and password reset (Resend). Without both, signups
# are not email-verified and reset links are only printed to the console in development.
RESEND_API_KEY=
EMAIL_FROM=

# Supabase (persistence; not required for the free audit flow)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
